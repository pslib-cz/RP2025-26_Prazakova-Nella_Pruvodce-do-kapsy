@page
@model pruvodce.server.Pages.Specializations.IndexModel
@{
    ViewData["Title"] = "Zaměření oborů";
}

<section class="admin-list">
    <div class="admin-list__card">
        <div class="admin-list__header">
            <div>
                <h2 class="admin-list__title">Zaměření oborů</h2>
                <p class="admin-list__subtitle">Konkrétní zaměření, která jsou k dispozici pro každý obor.</p>
            </div>

            <a asp-page="Create" class="admin-button admin-button--primary">
                + Přidat zaměření
            </a>
        </div>

        <form method="get" class="admin-list__filters" id="specializationFilterForm">
            <input asp-for="Search"
                   class="admin-list__search"
                   placeholder="Hledat podle názvu, popisu nebo oboru..."
                   oninput="submitSpecializationFilter()" />

            <select asp-for="Type"
                    asp-items="Model.TypeItems"
                    class="admin-list__select"
                    onchange="this.form.submit()">
                <option value="">Všechny obory</option>
            </select>
        </form>

        <div class="admin-table-wrap">
            <table class="admin-table admin-table--specializations">
                <thead>
                    <tr class="admin-table__row">
                        <th class="admin-table__cell admin-table__cell--head">Název</th>
                        <th class="admin-table__cell admin-table__cell--head">Popis</th>
                        <th class="admin-table__cell admin-table__cell--head">Akce</th>
                    </tr>
                </thead>

                <tbody class="admin-table__body">
                    @if (Model.Specializations.Any())
                    {
                        @foreach (var item in Model.Specializations)
                        {
                            var typeCode = item.Type?.ToString() ?? "-";
                            var typeClass = item.Type?.ToString().ToLower() ?? "default";

                            <tr class="admin-table__row">
                                <td class="admin-table__cell admin-table__cell--wrap">
                                    <div class="admin-table__title-with-mark">
                                        <span class="admin-field-mark admin-field-mark--@typeClass">
                                            @typeCode
                                        </span>

                                        <span class="admin-table__primary">
                                            @item.Name
                                        </span>
                                    </div>
                                </td>

                                <td class="admin-table__cell admin-table__cell--description">
                                    @item.Description
                                </td>

                                <td class="admin-table__cell admin-table__cell--actions">
                                    <div class="admin-table__actions admin-table__actions--stacked">
                                        <a asp-page="./Edit"
                                           asp-route-id="@item.SpecializationId"
                                           class="admin-button admin-button--secondary">
                                            Editovat
                                        </a>

                                        <a asp-page="./Delete"
                                           asp-route-id="@item.SpecializationId"
                                           class="admin-button admin-button--danger">
                                            Odebrat
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="admin-table__row">
                            <td colspan="3" class="admin-table__cell admin-table__cell--empty">
                                Zatím není vytvořeno žádné zaměření.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        let specializationSearchTimeout;

        function submitSpecializationFilter() {
            clearTimeout(specializationSearchTimeout);

            specializationSearchTimeout = setTimeout(() => {
                document.getElementById("specializationFilterForm").submit();
            }, 350);
        }
    </script>
}
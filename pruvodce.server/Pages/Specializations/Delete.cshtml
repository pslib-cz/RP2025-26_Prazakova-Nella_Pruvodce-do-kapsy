@page "{id}"
@model pruvodce.server.Pages.Specializations.DeleteModel
@{
    ViewData["Title"] = "Delete Specialization";
}

<h1>Delete Specialization</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Specialization</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Specialization?.Name</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Specialization?.Description</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Specialization.SpecializationId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
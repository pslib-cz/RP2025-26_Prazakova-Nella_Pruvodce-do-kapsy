@page
@model pruvodce.server.Pages.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Hlavní stránka";
}

<div class="admin-home">
    <section class="admin-home__event-card">
        <div class="admin-home__event-header">
            <div>
                <h2 class="admin-home__event-title">@Model.CurrentEventTitle</h2>
                <p class="admin-home__event-name">Aktuální akce</p>
            </div>
        </div>

        <div class="admin-home__event-controls">
            <form method="get" class="admin-home__filter" id="eventFilterForm">
                <input asp-for="Search"
                       class="admin-home__filter-input"
                       placeholder="Hledat body..."
                       oninput="submitEventFilter()" />
            <label for="BuildingId" class="visually-hidden">Budova
                <select asp-for="BuildingId"
                        asp-items="Model.BuildingItems"
                        class="admin-home__filter-select"
                        onchange="this.form.submit()">
                    <option value="">Všechny budovy</option>
                </select>
            </label>    
            </form>

            <a asp-page="/Points/Create" class="admin-button admin-button--primary">
                + Vytvořit stanoviště
            </a>
        </div>

        <div class="admin-table-wrap">
            <table class="admin-table admin-home__table">
                <thead class="admin-table__head">
                    <tr class="admin-table__row">
                        <th class="admin-table__cell admin-table__cell--head">Název</th>
                        <th class="admin-table__cell admin-table__cell--head">Budova</th>
                        <th class="admin-table__cell admin-table__cell--head">Místnost</th>
                        <th class="admin-table__cell admin-table__cell--head desktop-only">Specializace</th>
                    </tr>
                </thead>

                <tbody class="admin-table__body">
                    @if (Model.Points.Items.Any())
                    {
                        @foreach (var point in  Model.Points.Items)
                        {
                            <tr class="admin-table__row">
                                <td class="admin-table__cell">
                                    <span class="admin-table__primary-text">@point.Label</span>
                                </td>
                                <td class="admin-table__cell">@point.Building</td>
                                <td class="admin-table__cell">@point.Room</td>
                                <td class="admin-table__cell desktop-only">
                                    <span class="admin-badge admin-badge--purple">@point.Specialization</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="admin-table__row">
                            <td colspan="4" class="admin-table__cell admin-table__cell--empty">
                                Žádná stanoviště pro aktuální akci.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="admin-home__event-footer">
            <span>Zobrazuji @Model.Points.Items.Count stanovišť aktuální akce</span>
        </div>
    </section>

    <aside class="admin-home__side">
        <a asp-page="/Events/Index" class="admin-quick-card admin-quick-card--red">
            <div class="admin-quick-card__icon">
                <span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentcolor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 4V2m0 2v2m0-2h-4.5M3 10v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-9zm0 0V6a2 2 0 0 1 2-2h2m0-2v4m14 4V6a2 2 0 0 0-2-2h-.5"/></svg></span>
            </div>

            <div class="admin-quick-card__content">
                <div class="admin-quick-card__title">Akce</div>
                <div class="admin-quick-card__link">Zobrazit vše →</div>
            </div>
        </a>

        <a asp-page="/Points/Index" class="admin-quick-card admin-quick-card--blue">
            <div class="admin-quick-card__icon">
                <span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentcolor" stroke-width="1" d="M19.503 9.97c1.204.489 1.112 2.224-.137 2.583l-6.305 1.813l-2.88 5.895c-.571 1.168-2.296.957-2.569-.314L4.677 6.257A1.369 1.369 0 0 1 6.53 4.7z" clip-rule="evenodd"/></svg></span>
            </div>

            <div class="admin-quick-card__content">
                <div class="admin-quick-card__title">Stanoviště</div>
                <div class="admin-quick-card__link">Zobrazit vše →</div>
            </div>
        </a>

        <section class="admin-records-card">
            <h2 class="admin-records-card__title">Další záznamy</h2>

            <div class="admin-records-card__list">
                <a asp-page="/Teachers/Index" class="admin-records-card__item">
                    <div class="admin-records-card__icon admin-records-card__icon--pink"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentcolor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1"><path d="M12 12a4 4 0 1 0 0-8a4 4 0 0 0 0 8"/><path d="M5 20v-1a7 7 0 0 1 10-6.326m1.635 3.741l1.039-2.203a.357.357 0 0 1 .652 0l1.04 2.203l2.323.356c.298.045.416.429.2.649l-1.68 1.713l.396 2.421c.051.311-.26.548-.527.401L18 20.812l-2.078 1.143c-.267.147-.578-.09-.527-.4l.396-2.422l-1.68-1.713c-.216-.22-.098-.604.2-.65z"/></g></svg></div>

                    <div class="admin-records-card__text">
                        <div class="admin-records-card__name">Učitelé</div>
                        <div class="admin-records-card__count admin-records-card__count--pink">
                            @Model.TotalTeachersCount záznamů
                        </div>
                    </div>

                    <div class="admin-records-card__more">...</div>
                </a>

                <a asp-page="/Specializations/Index" class="admin-records-card__item">
                    <div class="admin-records-card__icon admin-records-card__icon--green"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentcolor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M13.992 17h3m3 0h-3m0 0v-3m0 3v3"/><path d="M4 9.4V4.6a.6.6 0 0 1 .6-.6h4.8a.6.6 0 0 1 .6.6v4.8a.6.6 0 0 1-.6.6H4.6a.6.6 0 0 1-.6-.6Zm0 10v-4.8a.6.6 0 0 1 .6-.6h4.8a.6.6 0 0 1 .6.6v4.8a.6.6 0 0 1-.6.6H4.6a.6.6 0 0 1-.6-.6Zm10-10V4.6a.6.6 0 0 1 .6-.6h4.8a.6.6 0 0 1 .6.6v4.8a.6.6 0 0 1-.6.6h-4.8a.6.6 0 0 1-.6-.6Z"/></g></svg></div>

                    <div class="admin-records-card__text">
                        <div class="admin-records-card__name">Zaměření</div>
                        <div class="admin-records-card__count admin-records-card__count--green">
                            @Model.TotalSpecializationsCount záznamů
                        </div>
                    </div>

                    <div class="admin-records-card__more">...</div>
                </a>

                <a asp-page="/Subjects/Index" class="admin-records-card__item">
                    <div class="admin-records-card__icon admin-records-card__icon--yellow"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentcolor" stroke-linecap="round" stroke-width="1"><path d="M4 19V5a2 2 0 0 1 2-2h13.4a.6.6 0 0 1 .6.6v13.114M6 17h14M6 21h14"/><path stroke-linejoin="round" d="M6 21a2 2 0 1 1 0-4"/><path d="M9 7h6"/></g></svg></div>

                    <div class="admin-records-card__text">
                        <div class="admin-records-card__name">Předměty</div>
                        <div class="admin-records-card__count admin-records-card__count--yellow">
                            @Model.TotalSubjectsCount záznamů
                        </div>
                    </div>

                    <div class="admin-records-card__more">...</div>
                </a>
            </div>
        </section>
    </aside>
</div>

@section Scripts {
    <script>
        let searchTimeout;

        function submitEventFilter() {
            clearTimeout(searchTimeout);

            searchTimeout = setTimeout(() => {
                document.getElementById("eventFilterForm").submit();
            }, 350);
        }
    </script>
}
@page "{id:int}"
@model pruvodce.server.Pages.Events.DeleteModel
@{
    ViewData["Title"] = "Delete Event";
}

<h1>Delete Event</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>Event</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Event?.Name</dd>

        <dt class="col-sm-2">Start</dt>
        <dd class="col-sm-10">@Model.Event?.StartDate.ToString("g")</dd>

        <dt class="col-sm-2">End</dt>
        <dd class="col-sm-10">@Model.Event?.EndDate.ToString("g")</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Event.EventId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
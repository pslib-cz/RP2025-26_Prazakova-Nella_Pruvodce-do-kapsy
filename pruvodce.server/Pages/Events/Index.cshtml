@page
@model pruvodce.server.Pages.Events.IndexModel
@{
    ViewData["Title"] = "Akce";
}

<section class="admin-list">
    <div class="admin-list__card">
        <div class="admin-list__header">
            <div>
                <h2 class="admin-list__title">Seznam akcí</h2>
                <p class="admin-list__subtitle">Zde můžete spravovat akce.</p>
            </div>

            <a asp-page="Create" class="admin-button admin-button--primary">
                + Přidat akci
            </a>
        </div>

        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr class="admin-table__row">
                        <th class="admin-table__cell admin-table__cell--head">Název</th>
                        <th class="admin-table__cell admin-table__cell--head">Začátek</th>
                        <th class="admin-table__cell admin-table__cell--head">Konec</th>
                        <th class="admin-table__cell admin-table__cell--head">Stav</th>
                        <th class="admin-table__cell admin-table__cell--head">Popis</th>
                        <th class="admin-table__cell admin-table__cell--head"></th>
                    </tr>
                </thead>

                <tbody class="admin-table__body">
                    @if (Model.Events.Items.Any())
                    {
                        @foreach (var item in Model.Events.Items)
                        {
                            <tr class="admin-table__row">
                                <td class="admin-table__cell">
                                    <span class="admin-table__primary">@item.Name</span>
                                </td>

                                <td class="admin-table__cell">@item.StartDate.ToString("dd.MM.yyyy HH:mm")</td>

                                <td class="admin-table__cell">@item.EndDate.ToString("dd.MM.yyyy HH:mm")</td>

                                <td class="admin-table__cell admin-table__cell--status">
                                    @if (item.IsActive)
                                    {
                                        <span class="admin-badge admin-badge--success">Aktivní</span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge admin-badge--muted">Neaktivní</span>
                                    }
                                </td>

                                <td class="admin-table__cell admin-table__cell--description">@item.Description</td>

                                <td class="admin-table__cell">
                                    <div class="admin-table__actions">
                                        <a asp-page="./Edit"
                                           asp-route-id="@item.EventId"
                                           class="admin-button admin-button--secondary">
                                            Editovat
                                        </a>

                                        <a asp-page="./Delete"
                                           asp-route-id="@item.EventId"
                                           class="admin-button admin-button--danger">
                                            Odebrat
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="admin-table__row">
                            <td colspan="5" class="admin-table__cell admin-table__cell--empty">
                                Zatím není vytvořena žádná akce.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="admin-pagination">
    <div class="admin-pagination__info">
        Zobrazuji @Model.Events.FirstItemNumber–@Model.Events.LastItemNumber z @Model.Events.TotalItems
    </div>

    <div class="admin-pagination__controls">
        @if (Model.Events.HasPreviousPage)
        {
            <a asp-page="./Index"
               asp-route-pageNumber="@(Model.Events.PageNumber - 1)"
               asp-route-pageSize="@Model.Events.PageSize"
               class="admin-pagination__button">
                ‹
            </a>
        }
        else
        {
            <span class="admin-pagination__button admin-pagination__button--disabled">‹</span>
        }

        @for (var i = 1; i <= Model.Events.TotalPages; i++)
        {
            if (i == Model.Events.PageNumber)
            {
                <span class="admin-pagination__button admin-pagination__button--active">@i</span>
            }
            else
            {
                <a asp-page="./Index"
                   asp-route-pageNumber="@i"
                   asp-route-pageSize="@Model.Events.PageSize"
                   class="admin-pagination__button">
                    @i
                </a>
            }
        }

        @if (Model.Events.HasNextPage)
        {
            <a asp-page="./Index"
               asp-route-pageNumber="@(Model.Events.PageNumber + 1)"
               asp-route-pageSize="@Model.Events.PageSize"
               class="admin-pagination__button">
                ›
            </a>
        }
        else
        {
            <span class="admin-pagination__button admin-pagination__button--disabled">›</span>
        }
    </div>
</div>
    </div>
</section>
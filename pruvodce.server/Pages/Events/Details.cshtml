@page "{id:int}"
@model pruvodce.server.Pages.Events.DetailsModel
@{
    ViewData["Title"] = "Event Details";
}

<h1>Event</h1>

<div>
    <h4>Event</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Event?.Name</dd>

        <dt class="col-sm-2">Start</dt>
        <dd class="col-sm-10">@Model.Event?.StartDate.ToString("g")</dd>

        <dt class="col-sm-2">End</dt>
        <dd class="col-sm-10">@Model.Event?.EndDate.ToString("g")</dd>

        <dt class="col-sm-2">Active</dt>
        <dd class="col-sm-10">@((Model.Event?.IsActive == true) ? "Yes" : "No")</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Event?.Description</dd>

        <dt class="col-sm-2">Points</dt>
        <dd class="col-sm-10">
            @if (Model.Points?.Any() == true)
            {
                <ul>
                @foreach (var p in Model.Points)
                {
                    <li>@p.Label (@p.RoomId)</li>
                }
                </ul>
            }
            else
            {
                <span class="text-muted">None</span>
            }
        </dd>
    </dl>
</div>

<p>
    <a asp-page="Edit" asp-route-id="@Model.Event?.EventId" class="btn btn-primary">Edit</a>
    <a asp-page="Index" class="btn btn-secondary">Back to list</a>
</p>
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Administrace</title>

    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="admin-layout">
        <aside class="admin-layout__sidebar">
            <a asp-page="/Index" class="admin-brand">
                <div class="admin-brand__logo">
                    <svg xmlns="http://www.w3.org/2000/svg" width="50" height="27" viewBox="0 0 50 27" fill="none">
                        <path d="M37 0C44.1797 0 50 5.8203 50 13C50 20.1797 44.1797 26 37 26C29.9287 26 24.175 20.3541 24.0029 13.3242L13.8682 23.459C12.5441 25.5842 10.1883 27 7.5 27C3.35786 27 0 23.6421 0 19.5C0 15.3579 3.35786 12 7.5 12C10.7929 12 13.5881 14.1229 14.5967 17.0742L26.5859 5.08594L26.6436 5.14355C29.0178 2.01863 32.7727 0 37 0ZM7.5 16C5.567 16 4 17.567 4 19.5C4 21.433 5.567 23 7.5 23C8.85311 23 10.0249 22.2312 10.6074 21.1074L10.5859 21.0859L10.6553 21.0156C10.876 20.557 11 20.043 11 19.5C11 17.567 9.433 16 7.5 16ZM37 4C32.0294 4 28 8.02944 28 13C28 17.9706 32.0294 22 37 22C41.9706 22 46 17.9706 46 13C46 8.02944 41.9706 4 37 4Z" fill="#4054FA"/>
                    </svg>
                </div>

                <div class="admin-brand__text">
                    <div class="admin-brand__title">
                        Průvodce<br />
                        do kapsy
                    </div>
                    <div class="admin-brand__subtitle">Průmyslovka Liberec</div>
                </div>
            </a>

            <nav class="admin-nav">
                <div class="admin-nav__group">
                    <a asp-page="/Dashboard"
                       class="admin-nav__item @(currentPage == "/Dashboard" ? "admin-nav__item--active" : "")">
                        <span class="admin-nav__icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentcolor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 21H7a4 4 0 0 1-4-4v-6.292a4 4 0 0 1 1.927-3.421l5-3.03a4 4 0 0 1 4.146 0l5 3.03A4 4 0 0 1 21 10.707V17a4 4 0 0 1-4 4h-2m-6 0v-4a3 3 0 0 1 3-3v0a3 3 0 0 1 3 3v4m-6 0h6"/></svg></span>
                        <span class="admin-nav__label">Hlavní stránka</span>
                    </a>

                    <a asp-page="/Events/Index"
                       class="admin-nav__item @(currentPage.StartsWith("/Events") ? "admin-nav__item--active" : "")">
                        <span class="admin-nav__icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentcolor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 4V2m0 2v2m0-2h-4.5M3 10v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-9zm0 0V6a2 2 0 0 1 2-2h2m0-2v4m14 4V6a2 2 0 0 0-2-2h-.5"/></svg></span>
                        <span class="admin-nav__label">Akce</span>
                    </a>

                    <a asp-page="/Points/Index"
                       class="admin-nav__item @(currentPage.StartsWith("/Points") ? "admin-nav__item--active" : "")">
                        <span class="admin-nav__icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentcolor" stroke-width="1" d="M19.503 9.97c1.204.489 1.112 2.224-.137 2.583l-6.305 1.813l-2.88 5.895c-.571 1.168-2.296.957-2.569-.314L4.677 6.257A1.369 1.369 0 0 1 6.53 4.7z" clip-rule="evenodd"/></svg></span>
                        <span class="admin-nav__label">Stanoviště</span>
                    </a>
                </div>

                <div class="admin-nav__divider"></div>

                <div class="admin-nav__group">
                    <a asp-page="/Teachers/Index"
                       class="admin-nav__item @(currentPage.StartsWith("/Teachers") ? "admin-nav__item--active" : "")">
                        <span class="admin-nav__icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentcolor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1"><path d="M12 12a4 4 0 1 0 0-8a4 4 0 0 0 0 8"/><path d="M5 20v-1a7 7 0 0 1 10-6.326m1.635 3.741l1.039-2.203a.357.357 0 0 1 .652 0l1.04 2.203l2.323.356c.298.045.416.429.2.649l-1.68 1.713l.396 2.421c.051.311-.26.548-.527.401L18 20.812l-2.078 1.143c-.267.147-.578-.09-.527-.4l.396-2.422l-1.68-1.713c-.216-.22-.098-.604.2-.65z"/></g></svg></span>
                        <span class="admin-nav__label">Učitelé</span>
                    </a>

                    <a asp-page="/Specializations/Index"
                       class="admin-nav__item @(currentPage.StartsWith("/Specializations") ? "admin-nav__item--active" : "")">
                        <span class="admin-nav__icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentcolor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M13.992 17h3m3 0h-3m0 0v-3m0 3v3"/><path d="M4 9.4V4.6a.6.6 0 0 1 .6-.6h4.8a.6.6 0 0 1 .6.6v4.8a.6.6 0 0 1-.6.6H4.6a.6.6 0 0 1-.6-.6Zm0 10v-4.8a.6.6 0 0 1 .6-.6h4.8a.6.6 0 0 1 .6.6v4.8a.6.6 0 0 1-.6.6H4.6a.6.6 0 0 1-.6-.6Zm10-10V4.6a.6.6 0 0 1 .6-.6h4.8a.6.6 0 0 1 .6.6v4.8a.6.6 0 0 1-.6.6h-4.8a.6.6 0 0 1-.6-.6Z"/></g></svg></span>
                        <span class="admin-nav__label">Zaměření oborů</span>
                    </a>

                    <a asp-page="/Subjects/Index"
                       class="admin-nav__item @(currentPage.StartsWith("/Subjects") ? "admin-nav__item--active" : "")">
                        <span class="admin-nav__icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentcolor" stroke-linecap="round" stroke-width="1"><path d="M4 19V5a2 2 0 0 1 2-2h13.4a.6.6 0 0 1 .6.6v13.114M6 17h14M6 21h14"/><path stroke-linejoin="round" d="M6 21a2 2 0 1 1 0-4"/><path d="M9 7h6"/></g></svg></span>
                        <span class="admin-nav__label">Předměty</span>
                    </a>
                </div>
            </nav>
        </aside>

        <main class="admin-layout__main">
            <header class="admin-layout__header">
                <h1 class="admin-layout__title">@ViewData["Title"]</h1>
            </header>

            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
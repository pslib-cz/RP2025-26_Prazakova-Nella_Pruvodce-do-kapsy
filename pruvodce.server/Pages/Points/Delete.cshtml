@page "{id}"
@model pruvodce.server.Pages.Points.DeleteModel
@{
    ViewData["Title"] = "Delete Point";
}

<h1>Delete Point</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Point</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Label</dt>
        <dd class="col-sm-10">@Model.Point?.Label</dd>

        <dt class="col-sm-2">Room</dt>
        <dt class="col-sm-2">Room</dt>
        <dd class="col-sm-10">@Model.Point?.RoomId</dd>

        <dt class="col-sm-2">Event</dt>
        <dd class="col-sm-10">@Model.Point?.Event?.Name</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Point.PointId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
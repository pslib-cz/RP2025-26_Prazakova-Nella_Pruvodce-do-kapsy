@page
@model pruvodce.server.Pages.Students.IndexModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Student - Průvodce do kapsy</title>
    <link rel="stylesheet" href="~/css/survey.css" asp-append-version="true" />
    <meta charset="utf-8" />
    
</head>
<body>

    <div class="page">

        <h1>Přidejte poznámku</h1>

        <div class="info-box">

            <div class="info-icon">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                    <path d="M12 2L4 5V11C4 16 7.4 20.7 12 22C16.6 20.7 20 16 20 11V5L12 2Z"
                          stroke="#2567E5"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round" />
                    <path d="M9 12L11 14L15 10"
                          stroke="#2567E5"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round" />
                </svg>
            </div>

            <div>
                <h2>Tvoje zpráva může být zobrazena uchazečům o studium jako zkušenost od současných studentů.</h2>
                <p>Piš prosím stručně, slušně a upřímně. Neuváděj nic, co nechceš veřejně sdílet.</p>
            </div>

        </div>

        @if (TempData["Success"] != null)
        {
            <div class="custom-modal-overlay" id="successModal">
                <div class="custom-modal">
                    <h2>Děkujeme za pomoc!</h2>
                    <p>@TempData["Success"]</p>
                    
                    <button type="button" class="submit-btn" onclick="document.getElementById('successModal').style.display='none'">
                        Zavřít
                    </button>
                </div>
            </div>
        }

        <form method="post" asp-page-handler="Submit">

        <div class="card">

            <div class="field">

                <label class="label">
                    Kam chcete přidat poznámku?
                </label>

                <select asp-for="StudentNote.TargetType"
                        id="type"
                        onchange="toggleFields()">

                    <option value="teacher">K učiteli</option>
                    <option value="subject">K předmětu</option>

                </select>

            </div>

            <div class="field" id="teacherField">

                <label class="label">
                    Vyberte učitele
                </label>

                <select asp-for="StudentNote.TeacherId"
                        asp-items="Model.TeacherItems">

                    <option value="">Vyberte</option>

                </select>

            </div>

            <div class="field"
                id="subjectField"
                style="display:none;">

                <label class="label">
                    Vyberte předmět
                </label>

                <select asp-for="StudentNote.SubjectId"
                        asp-items="Model.SubjectItems">

                    <option value="">Vyberte</option>

                </select>

            </div>

        </div>

        <div class="card">

            <div class="field">

                <label class="label">

                    Poznámka

                    <small>(max 300 znaků)</small>

                </label>

                <textarea asp-for="StudentNote.Text"
                        id="noteText"
                        maxlength="300"
                        required></textarea>

                <div class="counter">
                    <span id="charCount">0</span>/300
                </div>

            </div>

            <div class="field">

                <label class="label">
                    Vaše jméno
                </label>

                <div class="helper">
                    Toto jméno může být zvěřejněné. Můžeš použít křestní jméno, přezdívku nebo jen “žák / student”.
                </div>

                <input asp-for="StudentNote.StudentName"
                    required />

            </div>

            <div class="field">

                <label class="label">
                    Třída
                </label>

                <input asp-for="StudentNote.StudentClass"
                    placeholder="P3A"
                    required />

            </div>

        </div>

        <div class="submit-wrapper">

            <button type="submit"
                    class="submit-btn">

                Přidat poznámku

            </button>

        </div>

    </form>

    </div>

    <script>

        function toggleFields() {

            const type = document.getElementById('type').value;

            document.getElementById('teacherField').style.display =
                type === 'teacher' ? 'block' : 'none';

            document.getElementById('subjectField').style.display =
                type === 'subject' ? 'block' : 'none';

            document.getElementById('pointField').style.display =
                type === 'point' ? 'block' : 'none';
        }

        const textarea = document.getElementById('noteText');
        const counter = document.getElementById('charCount');

        textarea.addEventListener('input', function () {
            counter.textContent = textarea.value.length;
        });

    </script>

</body>
</html>

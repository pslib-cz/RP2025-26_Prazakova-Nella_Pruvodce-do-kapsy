@page "{id}"
@model pruvodce.server.Pages.Teachers.DeleteModel
@{
    ViewData["Title"] = "Delete Teacher";
}

<h1>Delete Teacher</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Teacher</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Full name</dt>
        <dd class="col-sm-10">@Model.Teacher?.FirstN @Model.Teacher?.LastN</dd>

        <dt class="col-sm-2">Degree</dt>
        <dd class="col-sm-10">@Model.Teacher?.Degree</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Teacher.TeacherId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
@page
@model pruvodce.server.Pages.Teachers.CreateModel
@{
    ViewData["Title"] = "Vytvořit učitele";
}

<section class="admin-form">
    <form method="post" class="admin-form__card">

        <div class="admin-form__header">
            <h2 class="admin-form__title">Vytvořit učitele</h2>
            <p class="admin-form__subtitle">Zadejte základní údaje</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="admin-form__validation"></div>

        <div class="admin-form__grid">

            <div class="admin-form__field admin-form__field--full">
                <label class="admin-form__label">Celé jméno</label>

                <div style="display:flex; gap: 0.75rem;">
                    <input asp-for="Teacher.Degree"
                           class="admin-form__input"
                           placeholder="Titul" />

                    <input asp-for="Teacher.FirstN"
                           class="admin-form__input"
                           placeholder="Jméno" />

                    <input asp-for="Teacher.LastN"
                           class="admin-form__input"
                           placeholder="Příjmení" />
                </div>

                <span asp-validation-for="Teacher.Degree" class="admin-form__validation"></span>
                <span asp-validation-for="Teacher.FirstN" class="admin-form__validation"></span>
                <span asp-validation-for="Teacher.LastN" class="admin-form__validation"></span>
            </div>

        </div>

        <div class="admin-form__actions">
            <button type="submit" class="admin-button admin-button--primary">
                Vytvořit
            </button>

            <a asp-page="Index" class="admin-button admin-button--secondary">
                Zpět
            </a>
        </div>

    </form>
</section>

<style>
    .admin-form__field {
        display: flex;
        flex-direction: column;
    }

    .admin-form__label {
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .admin-form__input,
    .admin-form__multiselect {
        padding: 0.75rem;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-family: inherit;
        font-size: 1rem;
    }

    .admin-form__multiselect {
        min-height: 180px;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const select = document.getElementById('notesSelect');

            select.addEventListener('change', function () {

                const selected = Array.from(select.selectedOptions);

                if (selected.length > 3) {

                    selected[selected.length - 1].selected = false;

                    alert('Můžete vybrat maximálně 3 poznámky.');
                }
            });
        });
    </script>
}
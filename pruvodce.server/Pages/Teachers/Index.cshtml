@page
@model pruvodce.server.Pages.Teachers.IndexModel
@{
    ViewData["Title"] = "Učitelé";
}

<section class="admin-list">
    <div class="admin-list__card">

        <div class="admin-list__header">
            <div>
                <h2 class="admin-list__title">Učitelé</h2>
                <p class="admin-list__subtitle">Seznam vyučujících, kteří se objevují na akcích.</p>
            </div>

            <a asp-page="Create" class="admin-button admin-button--primary">
                + Přidat vyučujícího
            </a>
        </div>

        <form method="get" class="admin-list__filters" id="teacherFilterForm">
            <input asp-for="Search"
                   class="admin-list__search"
                   placeholder="Hledat podle Jména, Příjmení, Titulu..."
                   oninput="submitTeacherFilter()" />
        </form>

        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr class="admin-table__row">
                        <th class="admin-table__cell admin-table__cell--head">Jméno</th>
                        <th class="admin-table__cell admin-table__cell--head">Poznámka</th>
                        <th class="admin-table__cell admin-table__cell--head">Akce</th>
                    </tr>
                </thead>

                <tbody class="admin-table__body">
                    @if (Model.Teachers.Any())
                    {
                        @foreach (var item in Model.Teachers)
                        {
                            <tr class="admin-table__row">

                                <td class="admin-table__cell">
                                    <span class="admin-table__primary">
                                        @(string.IsNullOrWhiteSpace(item.Degree)
                                            ? $"{item.FirstN} {item.LastN}"
                                            : $"{item.Degree} {item.FirstN} {item.LastN}")
                                    </span>
                                </td>

                                <td class="admin-table__cell admin-table__cell--notes">
                                    @{
                                        var selectedCount = 0;

                                        if (!string.IsNullOrEmpty(item.SelectedNoteIds))
                                        {
                                            try
                                            {
                                                var ids = System.Text.Json.JsonSerializer.Deserialize<List<string>>(item.SelectedNoteIds);
                                                selectedCount = ids?.Count ?? 0;
                                            }
                                            catch
                                            {
                                                selectedCount = 0;
                                            }
                                        }

                                        var totalNotes = item.Notes?.Count ?? 0;
                                    }

                                    @if (selectedCount > 0)
                                    {
                                        <span class="admin-table__note-badge">
                                            @selectedCount/3 <span class="note-badge__hint">(celkem poznámek: @totalNotes)</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-table__note-empty">
                                            ✕
                                        </span>
                                    }
                                </td>

                                <td class="admin-table__cell">
                                    <div class="admin-table__actions">
                                        <a asp-page="./Edit"
                                           asp-route-id="@item.TeacherId"
                                           class="admin-button admin-button--secondary">
                                            Upravit
                                        </a>

                                        <a asp-page="./Delete"
                                           asp-route-id="@item.TeacherId"
                                           class="admin-button admin-button--danger">
                                            Odebrat
                                        </a>
                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="admin-table__row">
                            <td colspan="3" class="admin-table__cell admin-table__cell--empty">
                                Žádní učitelé nebyli nalezeni.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</section>
@section Scripts {
<script>
    let teacherTimeout;

    function submitTeacherFilter() {
        clearTimeout(teacherTimeout);

        teacherTimeout = setTimeout(() => {
            document.getElementById("teacherFilterForm").submit();
        }, 300);
    }
</script>
}
@page
@model pruvodce.server.Pages.Subjects.CreateModel
@{
    ViewData["Title"] = "Vytvořit předmět";
}

<section class="admin-form">
    <form method="post" class="admin-form__card">

        <div class="admin-form__header">
            <h2 class="admin-form__title">Vytvořit předmět</h2>
            <p class="admin-form__subtitle">Zadejte základní údaje</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="admin-form__validation"></div>

        <div class="admin-form__grid">

            <div class="admin-form__field admin-form__field--full">

            <div class="admin-form__field">
                <label asp-for="Subject.Name" class="admin-form__label">Název</label>
                <input asp-for="Subject.Name" class="admin-form__input"/>
                <span asp-validation-for="Subject.Name" class="admin-form__validation"></span>
            </div>

            <div class="admin-form__field">
                <label asp-for="Subject.Acronym" class="admin-form__label">Zkratka</label>
                <input asp-for="Subject.Acronym" class="admin-form__input"/>
                <span asp-validation-for="Subject.Acronym" class="admin-form__validation"></span>
            </div>

            <span asp-validation-for="Subject.Name" class="admin-form__validation"></span>
            <span asp-validation-for="Subject.Acronym" class="admin-form__validation"></span>


            <div class="admin-form__field admin-form__field--full" style="padding-top: 1.5rem;">
                <label asp-for="Note.Text" class="admin-form__label">Poznámka od studentů</label>
                <textarea asp-for="Note.Text" class="admin-form__textarea"></textarea>
                <span asp-validation-for="Note.Text" class="admin-form__validation"></span>
            </div>

            <div style="display:flex; flex-direction: row; gap: 1rem;" class="admin-form__field admin-form__field--full">
                <div class="admin-form__field">
                    <label asp-for="Note.StudentName" class="admin-form__label">Křestní jméno</label>
                    <input asp-for="Note.StudentName" class="admin-form__input" />
                    <span asp-validation-for="Note.StudentName" class="admin-form__validation"></span>
                </div>

                <div class="admin-form__field">
                    <label asp-for="Note.StudentField" class="admin-form__label">Obor</label>
                    <select asp-for="Note.StudentField" asp-items="Model.NoteFieldItems" class="admin-form__input">
                        <option value="">Vyberte obor</option>
                    </select>
                    <span asp-validation-for="Note.StudentField" class="admin-form__validation"></span>
                </div>
            </div>

        </div>

        <div class="admin-form__actions">
            <button type="submit" class="admin-button admin-button--primary">
                Vytvořit
            </button>
            <a asp-page="Index" class="admin-button admin-button--secondary">
                Zpět
            </a>
        </div>

    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
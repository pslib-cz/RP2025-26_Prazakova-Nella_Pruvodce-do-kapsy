@page "{id}"
@model pruvodce.server.Pages.Subjects.DeleteModel
@{
    ViewData["Title"] = "Delete Subject";
}

<h1>Delete Subject</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Subject</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Subject?.Name</dd>

        <dt class="col-sm-2">Acronym</dt>
        <dd class="col-sm-10">@Model.Subject?.Acronym</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Subject.SubjectId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
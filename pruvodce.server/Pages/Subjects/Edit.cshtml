@page "{id}"
@model pruvodce.server.Pages.Subjects.EditModel
@{
    ViewData["Title"] = "Edit Subject";
}

<h1>Edit Subject</h1>

<form method="post">
    <input type="hidden" asp-for="Subject.SubjectId" />
    <div class="form-group">
        <label asp-for="Subject.Name"></label>
        <input asp-for="Subject.Name" class="form-control" />
        <span asp-validation-for="Subject.Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Subject.Acronym"></label>
        <input asp-for="Subject.Acronym" class="form-control" />
        <span asp-validation-for="Subject.Acronym" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Subject.Note"></label>
        <textarea asp-for="Subject.Note" class="form-control"></textarea>
        <span asp-validation-for="Subject.Note" class="text-danger"></span>
    </div>
    <input type="hidden" asp-for="Subject.SubjectId" />

    <div class="form-group">
        <label asp-for="Subject.Name"></label>
        <input asp-for="Subject.Name" class="form-control" />
        <span asp-validation-for="Subject.Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Subject.Acronym"></label>
        <input asp-for="Subject.Acronym" class="form-control" />
        <span asp-validation-for="Subject.Acronym" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Subject.Note"></label>
        <textarea asp-for="Subject.Note" class="form-control"></textarea>
        <span asp-validation-for="Subject.Note" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Teachers</label>
        <select asp-for="SelectedTeacherIds"
                asp-items="Model.TeacherItems"
                class="form-control searchable-multiselect"
                multiple>
        </select>
    </div>

    <div class="form-group">
        <label>Points</label>
        <select asp-for="SelectedPointIds"
                asp-items="Model.PointItems"
                class="form-control searchable-multiselect"
                multiple>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Back to list</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            $('.searchable-multiselect').select2({
                placeholder: 'Vyber položky',
                allowClear: true,
                width: '100%'
            });
        });
    </script>
}
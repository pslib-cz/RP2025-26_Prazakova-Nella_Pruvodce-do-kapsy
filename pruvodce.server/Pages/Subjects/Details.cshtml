@page "{id}"
@model pruvodce.server.Pages.Subjects.DetailsModel
@{
    ViewData["Title"] = "Subject Details";
}

<h1>Subject</h1>

<div>
    <h4>Subject</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Subject?.Name</dd>

        <dt class="col-sm-2">Acronym</dt>
        <dd class="col-sm-10">@Model.Subject?.Acronym</dd>

        <dt class="col-sm-2">Note</dt>
        <dd class="col-sm-10">@Model.Subject?.Note</dd>

        <dt class="col-sm-2">Points</dt>
        <dd class="col-sm-10">
            @if (Model.Subject?.PointSubjects?.Any() == true)
            {
                <ul>
                @foreach (var ps in Model.Subject.PointSubjects)
                {
                    <li><a asp-page="/Points/Details" asp-route-id="@ps.PointId">@ps.Point.Label</a></li>
                }
                </ul>
            }
            else
            {
                <span class="text-muted">None</span>
            }
        </dd>
    </dl>
</div>

<p>
    <a asp-page="Edit" asp-route-id="@Model.Subject?.SubjectId" class="btn btn-primary">Edit</a>
    <a asp-page="Index" class="btn btn-secondary">Back to list</a>
</p>
@page
@model pruvodce.server.Pages.Subjects.EditModel
@{
    ViewData["Title"] = "Upravit předmět";
}

<section class="admin-form">
    <form method="post" class="admin-form__card">

    <input type="hidden" asp-for="Subject.SubjectId" />

        <div class="admin-form__header">
            <h2 class="admin-form__title">Upravit předmět</h2>
            <p class="admin-form__subtitle">Zadejte základní údaje</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="admin-form__validation"></div>

        <div class="admin-form__grid">

            <div class="admin-form__field admin-form__field--full">
                <div class="admin-form__field">
                    <label asp-for="Subject.Name" class="admin-form__label">Název</label>
                    <input asp-for="Subject.Name" class="admin-form__input"/>
                    <span asp-validation-for="Subject.Name" class="admin-form__validation"></span>
                </div>

                <div class="admin-form__field">
                    <label asp-for="Subject.Acronym" class="admin-form__label">Zkratka</label>
                    <input asp-for="Subject.Acronym" class="admin-form__input"/>
                    <span asp-validation-for="Subject.Acronym" class="admin-form__validation"></span>
                </div>
            </div>

            <div class="admin-form__field admin-form__field--full" style="padding-top: 1.5rem;">
                <label class="admin-form__label">Poznámka od studentů</label>

                @if (Model.AvailableNotes.Any())
                {
                    <div class="notes-box">
                        @foreach (var note in Model.AvailableNotes)
                        {
                            <label class="notes-box__item">
                                <input type="radio"
                                    name="SelectedActiveNoteId"
                                    value="@note.StudentNoteId"
                                    @(note.StudentNoteId == Model.SelectedActiveNoteId ? "checked" : "") />

                                <div class="notes-box__content">
                                    <div class="notes-box__title">
                                        @note.StudentName, @note.StudentClass
                                    </div>
                                    <div class="notes-box__text">
                                        @note.Text
                                    </div>
                                </div>
                            </label>
                        }

                        <label class="notes-box__item notes-box__none">
                            <input type="radio"
                                name="SelectedActiveNoteId"
                                value=""
                                @(string.IsNullOrEmpty(Model.SelectedActiveNoteId) ? "checked" : "") />

                            <div class="notes-box__content">
                                <div class="notes-box__title">
                                    Bez poznámky
                                </div>
                            </div>
                        </label>
                    </div>
                }
                else
                {
                    <p style="color: #999;">Zatím nejsou k tomuto předmětu žádné poznámky od studentů.</p>
                }
            </div>

        </div>

        <div class="admin-form__actions">
            <button type="submit" class="admin-button admin-button--primary">
                Uložit
            </button>

            <a asp-page="Index" class="admin-button admin-button--secondary">
                Zpět
            </a>
        </div>

    </form>
</section>

<style>
    .admin-form__field {
        display: flex;
        flex-direction: column;
    }

    .admin-form__label {
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .admin-form__input {
        padding: 0.75rem;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-family: inherit;
        font-size: 1rem;
    }

    .notes-box__text {
        color: #666;
        font-size: 0.9rem;
        margin-top: 0.25rem;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

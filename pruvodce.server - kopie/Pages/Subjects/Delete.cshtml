@page "{id}"
@model pruvodce.server.Pages.Subjects.DeleteModel
@{
    ViewData["Title"] = "Delete Subject";
}
<section class="admin-delete">
    <div class="admin-delete__card">
        <h2 class="admin-delete__title">Opravdu chcete odebrat tento předmět?</h2>
        <p class="admin-delete__text">
            Tato akce smaže vybraný záznam. Pokud je na něj něco navázané, může být potřeba nejdříve upravit související data.
        </p>

        @if (Model.Subject != null)
        {
            <div class="admin-delete__summary">
                <div class="admin-delete__row">
                    <div class="admin-delete__label">Název</div>
                    <div class="admin-delete__value">@Model.Subject.Name</div>
                </div>

                <div class="admin-delete__row">
                    <div class="admin-delete__label">Popis</div>
                    <div class="admin-delete__value">@Model.Subject.ActiveNote?.Text</div>
                </div>
            </div>

            <form method="post" class="admin-delete__actions">
                <input type="hidden" asp-for="Subject.SubjectId" />

                <button type="submit" class="admin-button admin-button--danger">
                    Odebrat
                </button>

                <a asp-page="Index" class="admin-button admin-button--secondary">
                    Zpět
                </a>
            </form>
        }
    </div>
</section>
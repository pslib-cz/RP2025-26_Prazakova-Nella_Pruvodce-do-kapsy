@page "{id}"
@model pruvodce.server.Pages.Specializations.DeleteModel

<section class="admin-delete">
    <div class="admin-delete__card">
        <h2 class="admin-delete__title">Opravdu chcete odebrat tuto specializaci?</h2>

        <p class="admin-delete__text">
            Tato akce smaže specializaci. U @Model.RelatedPointsCount bodů bude odstraněna vazba.
        </p>

        <div class="admin-delete__summary">
            <div class="admin-delete__row">
                <div class="admin-delete__label">Název</div>
                <div class="admin-delete__value">@Model.Specialization?.Name</div>
            </div>
            <div class="admin-delete__row">
                <div class="admin-delete__label">Popis</div>
                <div class="admin-delete__value">@Model.Specialization?.Description</div>
            </div>
        </div>

        <form method="post" class="admin-delete__actions">
            <input type="hidden" asp-for="Specialization.SpecializationId" />

            <button type="submit" class="admin-button admin-button--danger">
                Odebrat
            </button>

            <a asp-page="Index" class="admin-button admin-button--secondary">
                Zpět
            </a>
        </form>
    </div>
</section>
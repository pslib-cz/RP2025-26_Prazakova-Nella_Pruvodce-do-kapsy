@page
@model pruvodce.server.Pages.Points.IndexModel
@{
    ViewData["Title"] = "Stanoviště";
}

<section class="admin-list">
    <div class="admin-list__card">
        <div class="admin-list__header">
            <div>
                <h2 class="admin-list__title">Seznam stanovišť</h2>
            </div>

            <a asp-page="Create" class="admin-button admin-button--primary">
                + Přidat stanoviště
            </a>
        </div>

        <form method="get" class="admin-list__filters" id="pointsFilterForm">
            <input asp-for="Search"
                   class="admin-list__search"
                   placeholder="Hledat podle názvu, místnosti, akce, specializace..."
                   oninput="submitPointsFilter()" />

            <select asp-for="SpecializationId"
                asp-items="Model.SpecializationItems"
                class="admin-list__select"
                onchange="this.form.submit()">
            <option value="">Všechna zaměření</option>
        </select>

            <input type="hidden" name="pageSize" value="@Model.PageSize" />
        </form>

        <div class="admin-table-wrap">
            <table class="admin-table admin-table--points">
                <thead>
                    <tr class="admin-table__row">
                        <th class="admin-table__cell admin-table__cell--head admin-table__cell--icon">Ikona</th>
                        <th class="admin-table__cell admin-table__cell--head">Název</th>
                        <th class="admin-table__cell admin-table__cell--head">Místnost</th>
                        <th class="admin-table__cell admin-table__cell--head">Zaměření</th>
                        <th class="admin-table__cell admin-table__cell--head admin-table__cell--actions"></th>
                    </tr>
                </thead>

                <tbody class="admin-table__body">
                    @if (Model.Points.Items.Any())
                    {
                        @foreach (var item in Model.Points.Items)
                        {
                            <tr class="admin-table__row">
                                <td class="admin-table__cell admin-table__cell--icon">
                                    <div class="admin-point-icon admin-point-icon--@item.FieldTypeClass">
                                        <img src="@item.IconPath"
                                            alt="@item.IconText"
                                            class="admin-point-icon__image" />
                                    </div>
                                </td>

                                <td class="admin-table__cell admin-table__cell--wrap">
                                    <span class="admin-table__primary">@item.Label</span>
                                </td>

                                <td class="admin-table__cell admin-table__cell--wrap">
                                    @item.Room
                                </td>

                                <td class="admin-table__cell admin-table__cell--wrap">
                                    @item.SpecializationName
                                </td>

                                <td class="admin-table__cell admin-table__cell--actions">
                                    <div class="admin-table__actions admin-table__actions--inline">
                                        <a asp-page="./Edit"
                                        asp-route-id="@item.PointId"
                                        class="admin-button admin-button--secondary">
                                            Editovat
                                        </a>

                                        <a asp-page="./Delete"
                                        asp-route-id="@item.PointId"
                                        class="admin-button admin-button--danger">
                                            Odebrat
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="admin-table__row">
                            <td colspan="5" class="admin-table__cell admin-table__cell--empty">
                                Zatím není vytvořeno žádné stanoviště.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="admin-pagination">
            <div class="admin-pagination__info">
                Zobrazuji @Model.Points.FirstItemNumber–@Model.Points.LastItemNumber z @Model.Points.TotalItems
            </div>

            <div class="admin-pagination__controls">
                @if (Model.Points.HasPreviousPage)
                {
                    <a asp-page="./Index"
                       asp-route-pageNumber="@(Model.Points.PageNumber - 1)"
                       asp-route-pageSize="@Model.Points.PageSize"
                       asp-route-search="@Model.Search"
                       asp-route-specializationId="@Model.SpecializationId"
                       class="admin-pagination__button">
                        ‹
                    </a>
                }
                else
                {
                    <span class="admin-pagination__button admin-pagination__button--disabled">‹</span>
                }

                @for (var i = 1; i <= Model.Points.TotalPages; i++)
                {
                    if (i == Model.Points.PageNumber)
                    {
                        <span class="admin-pagination__button admin-pagination__button--active">@i</span>
                    }
                    else
                    {
                        <a asp-page="./Index"
                           asp-route-pageNumber="@i"
                           asp-route-pageSize="@Model.Points.PageSize"
                           asp-route-search="@Model.Search"
                           asp-route-specializationId="@Model.SpecializationId"
                           class="admin-pagination__button">
                            @i
                        </a>
                    }
                }

                @if (Model.Points.HasNextPage)
                {
                    <a asp-page="./Index"
                       asp-route-pageNumber="@(Model.Points.PageNumber + 1)"
                       asp-route-pageSize="@Model.Points.PageSize"
                       asp-route-search="@Model.Search"
                       asp-route-specializationId="@Model.SpecializationId"
                       class="admin-pagination__button">
                        ›
                    </a>
                }
                else
                {
                    <span class="admin-pagination__button admin-pagination__button--disabled">›</span>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        let pointsSearchTimeout;

        function submitPointsFilter() {
            clearTimeout(pointsSearchTimeout);

            pointsSearchTimeout = setTimeout(() => {
                document.getElementById("pointsFilterForm").submit();
            }, 350);
        }
    </script>
}
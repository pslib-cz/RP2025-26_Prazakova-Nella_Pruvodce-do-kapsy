@page "{id}"
@model pruvodce.server.Pages.Points.DetailsModel
@{
    ViewData["Title"] = "Point Details";
}

<h1>Point</h1>

<div>
    <h4>Point</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Label</dt>
        <dd class="col-sm-10">@Model.Point?.Label</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Point?.Description</dd>

        <dt class="col-sm-2">Room</dt>
        <dd class="col-sm-10">@Model.Point?.RoomId</dd>

        <dt class="col-sm-2">Teachers</dt>
        <dd class="col-sm-10">
            @if (Model.Point?.PointTeachers?.Any() == true)
            {
                <ul>
                @foreach (var pt in Model.Point.PointTeachers)
                {
                    <li>@pt.Teacher.FirstN @pt.Teacher.LastN</li>
                }
                </ul>
            }
            else
            {
                <span class="text-muted">None</span>
            }
        </dd>

        <dt class="col-sm-2">Subjects</dt>
        <dd class="col-sm-10">
            @if (Model.Point?.PointSubjects?.Any() == true)
            {
                <ul>
                @foreach (var ps in Model.Point.PointSubjects)
                {
                    <li>@ps.Subject?.Name (@ps.Subject?.Acronym)</li>
                }
                </ul>
            }
            else
            {
                <span class="text-muted">None</span>
            }
        </dd>

        <dt class="col-sm-2">Specialization</dt>
        <dd class="col-sm-10">@Model.Point?.Specialization?.Name</dd>

        <dt class="col-sm-2">Are Students</dt>
        <dd class="col-sm-10">@((Model.Point?.AreStudents == true) ? "Yes" : "No")</dd>
    </dl>
</div>

<p>
    <a asp-page="Edit" asp-route-id="@Model.Point?.PointId" class="btn btn-primary">Edit</a>
    <a asp-page="Index" class="btn btn-secondary">Back to list</a>
</p>

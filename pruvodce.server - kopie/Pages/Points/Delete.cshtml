@page "{id}"
@model pruvodce.server.Pages.Points.DeleteModel
@{
    ViewData["Title"] = "Delete Point";
}
<section class="admin-delete">
    <div class="admin-delete__card">
        <h2 class="admin-delete__title">Opravdu chcete odebrat tento bod?</h2>
        <p class="admin-delete__text">
            Tato akce smaže vybraný záznam.
        </p>

        @if (Model.Point != null)
        {
            <div class="admin-delete__summary">
                <div class="admin-delete__row">
                    <div class="admin-delete__label">Název</div>
                    <div class="admin-delete__value">@Model.Point.Label</div>
                </div>

                <div class="admin-delete__row">
                    <div class="admin-delete__label">Místnost</div>
                    <div class="admin-delete__value">@Model.Point.RoomId</div>
                </div>
            </div>

            <form method="post" class="admin-delete__actions">
                <input type="hidden" asp-for="Point.PointId" />

                <button type="submit" class="admin-button admin-button--danger">
                    Odebrat
                </button>

                <a asp-page="Index" class="admin-button admin-button--secondary">
                    Zpět
                </a>
            </form>
        }
    </div>
</section>

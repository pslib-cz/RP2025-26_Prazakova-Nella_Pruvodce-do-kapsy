<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @await RenderSectionAsync("Styles", required: false)
    <title>@ViewData["Title"] - Průvodce do kapsy</title>
    <style>
        body {
            padding-top: 60px;
        }

        .navbar-brand {
            font-weight: bold;
        }

        .sidebar-nav {
            background-color: #f8f9fa;
            border-radius: 5px;
            padding: 15px;
            margin-bottom: 20px;
        }

            .sidebar-nav h5 {
                margin-top: 20px;
                margin-bottom: 10px;
                font-weight: bold;
                color: #333;
            }

            .sidebar-nav a {
                display: block;
                padding: 8px 15px;
                color: #0d6efd;
                text-decoration: none;
                border-radius: 3px;
            }

                .sidebar-nav a:hover {
                    background-color: #e9ecef;
                    color: #0a58ca;
                }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">📚 Průvodce</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Domů</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            ⚙️ Admin
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-page="/Events/Index">Události</a></li>

                            <li><a class="dropdown-item" asp-page="/Teachers/Index">Učitelé</a></li>

                            <li><a class="dropdown-item" asp-page="/Subjects/Index">Předměty</a></li>

                            <li><a class="dropdown-item" asp-page="/Specializations/Index">Specializace</a></li>

                            <li><a class="dropdown-item" asp-page="/Points/Index">Stanoviště</a></li>

                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-page="/Privacy">Soukromí</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-5">
        @RenderBody()
    </main>

    <footer class="bg-light py-4 mt-5 border-top">
        <div class="container text-center">
            <p class="text-muted mb-0">&copy; 2025 Průvodce do kapsy</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
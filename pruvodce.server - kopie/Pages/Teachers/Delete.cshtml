@page "{id}"
@model pruvodce.server.Pages.Teachers.DeleteModel
@{
    ViewData["Title"] = "Delete Teacher";
}

<section class="admin-delete">
    <div class="admin-delete__card">
        <h2 class="admin-delete__title">Opravdu chcete odebrat tohoto učitele?</h2>
        <p class="admin-delete__text">
            Tato akce smaže vybraný záznam. Pokud je na něj něco navázané, může být potřeba nejdříve upravit související data.
        </p>

        @if (Model.Teacher != null)
        {
            <div class="admin-delete__summary">
                <div class="admin-delete__row">
                    <div class="admin-delete__label">Jméno</div>
                    <div class="admin-delete__value">@Model.Teacher.FirstN @Model.Teacher.LastN</div>
                </div>
                <div class="admin-delete__row">
                    <div class="admin-delete__label">Poznámka od studentů</div>
                    <div class="admin-delete__value">
                    @foreach (var note in Model.Teacher.Notes)
                    {
                        <p>@note.Text</p>
                    }</div>
                </div>
            </div>

            <form method="post" class="admin-delete__actions">
                <input type="hidden" asp-for="Teacher.TeacherId" />

                <button type="submit" class="admin-button admin-button--danger">
                    Odebrat
                </button>

                <a asp-page="Index" class="admin-button admin-button--secondary">
                    Zpět
                </a>
            </form>
        }
    </div>
</section>
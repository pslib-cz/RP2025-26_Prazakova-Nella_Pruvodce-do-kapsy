@page "{id}"
@model pruvodce.server.Pages.Events.DeleteModel
@{
    ViewData["Title"] = "Odebrat akci";
}

<section class="admin-delete">
    <div class="admin-delete__card">
        <h2 class="admin-delete__title">Opravdu chcete odebrat tuto akci?</h2>
        <p class="admin-delete__text">
            Tato akce smaže vybraný záznam. Pokud je na něj něco navázané, může být potřeba nejdříve upravit související data.
        </p>

        @if (Model.Event != null)
        {
            <div class="admin-delete__summary">
                <div class="admin-delete__row">
                    <div class="admin-delete__label">Název</div>
                    <div class="admin-delete__value">@Model.Event.Name</div>
                </div>

                <div class="admin-delete__row">
                    <div class="admin-delete__label">Začátek</div>
                    <div class="admin-delete__value">@(Model.Event.StartDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</div>
                </div>

                <div class="admin-delete__row">
                    <div class="admin-delete__label">Konec</div>
                    <div class="admin-delete__value">@(Model.Event.EndDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</div>
                </div>
            </div>

            <form method="post" class="admin-delete__actions">
                <input type="hidden" asp-for="Event.EventId" />

                <button type="submit" class="admin-button admin-button--danger">
                    Odebrat
                </button>

                <a asp-page="Index" class="admin-button admin-button--secondary">
                    Zpět
                </a>
            </form>
        }
    </div>
</section>